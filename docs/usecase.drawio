urce="c5" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;endFill=0;dashed=1;html=1;fontStyle=2;strokeColor=#2c7a3f;fontColor=#2c7a3f;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="&lt;&lt;extend&gt;&gt;" style="endArrow=open;endFill=0;dashed=1;html=1;fontStyle=2;strokeColor=#a0332b;fontColor=#a0332b;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="&lt;&lt;extend&gt;&gt;" style="endArrow=open;endFill=0;dashed=1;html=1;fontStyle=2;strokeColor=#a0332b;fontColor=#a0332b;" edge="1" parent="1" source="c9" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;— Đường liền: association (actor tham gia use case)&lt;br&gt;- - &gt; &amp;lt;&amp;lt;include&amp;gt;&amp;gt;: UC gốc luôn gọi UC được include&lt;br&gt;- - &gt; &amp;lt;&amp;lt;extend&amp;gt;&amp;gt;: UC mở rộng chỉ chạy khi có điều kiện (trỏ về UC gốc)&lt;br&gt;Khung chữ nhật = ranh giới hệ thống · Oval = use case · Người que = actor" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=none;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="130" y="600" width="580" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>