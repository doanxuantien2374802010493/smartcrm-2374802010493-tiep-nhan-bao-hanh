"geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;① [3a] Khách chưa tồn tại (UC2 bước 3)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Không tìm thấy khách có SĐT 0901234567. Hãy tạo hồ sơ khách hàng mới (FR2)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=15;fontColor=#7F1D1D;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="960" y="150" width="560" height="150" as="geometry"/></mxCell><mxCell id="c51" value="+ Tạo khách hàng mới" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=16;fontColor=#1E3A8A;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="248" width="260" height="38" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;① [FR8] Tên không khớp (US8 - COULD)&lt;/b&gt;&lt;br&gt;&lt;br&gt;SĐT đã tồn tại với tên “Nguyễn Văn A”. Tên vừa nhập không khớp — vui lòng kiểm tra lại." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=15;fontColor=#7C2D12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="960" y="320" width="560" height="130" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;② [5a] Không có ngày mua (QT-05)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bảo hành: CHƯA XÁC MINH — không có ngày mua. Phiếu vẫn được lưu và chờ Quản lý duyệt (warranty_verified = false)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=15;fontColor=#7C2D12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="960" y="470" width="560" height="150" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;② Hết hạn bảo hành (QT-05)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ngày mua + số tháng bảo hành đã quá ngày tiếp nhận → phiếu tính phí (is_warranty = false)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=15;fontColor=#7C2D12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="960" y="640" width="560" height="130" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;③ [8a] Thiếu mô tả lỗi (UC2 bước 8)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vui lòng nhập mô tả lỗi (bắt buộc). Không thể lưu phiếu." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=15;fontColor=#7F1D1D;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="960" y="790" width="560" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>