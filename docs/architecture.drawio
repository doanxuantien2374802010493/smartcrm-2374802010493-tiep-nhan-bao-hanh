<mxfile host="app.diagrams.net"><diagram name="Kiến trúc phân lớp L2" id="Kiến_trúc_phân_lớp_L2"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1330" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#555555;strokeWidth=2;fontSize=14;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=14;dashed=1;dashPattern=8 6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="1680" height="1000" as="geometry"/></mxCell><mxCell id="c3" value="Hệ thống L2 — kiến trúc phân lớp (trong phạm vi)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontSize=22;fontColor=#1a1a1a;align=left;verticalAlign=middle;spacingLeft=14;fontStyle=1;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="90" y="55" width="900" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:22px'&gt;Giao diện React (Vite)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:16px'&gt;Hiển thị form, danh sách; gọi API; không chứa quy tắc nghiệp vụ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=3;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="120" width="960" height="125" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:22px'&gt;Express API (Controller)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:16px'&gt;Nhận request, xác thực vai trò, validate định dạng, trả mã HTTP&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;strokeWidth=3;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="312" width="960" height="125" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:22px'&gt;Service (nghiệp vụ)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:16px'&gt;Áp dụng QT-01…QT-06, QT-13…QT-15; che SĐT theo vai trò; sinh hạn cam kết&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE68A;strokeColor=#B45309;strokeWidth=3;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="504" width="960" height="125" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:22px'&gt;Repository (Prisma)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:16px'&gt;Chỉ truy vấn/ghi CSDL trong transaction; không biết quy tắc nghiệp vụ&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F9488;strokeWidth=3;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="696" width="960" height="125" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:22px'&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:16px'&gt;Lưu 7 bảng: customer, device, ticket, issue_category, ticket_status_log, service_center, employee&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#555555;strokeWidth=3;fontSize=14;fontColor=#222222;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="888" width="960" height="125" as="geometry"/></mxCell><mxCell id="e9" value="HTTP/JSON (REST)" style="endArrow=open;endFill=0;strokeWidth=2;strokeColor=#444444;fontSize=14;fontStyle=2;fontColor=#444444;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="Gọi hàm (DTO)" style="endArrow=open;endFill=0;strokeWidth=2;strokeColor=#444444;fontSize=14;fontStyle=2;fontColor=#444444;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="Gọi hàm (entity)" style="endArrow=open;endFill=0;strokeWidth=2;strokeColor=#444444;fontSize=14;fontStyle=2;fontColor=#444444;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="SQL qua Prisma Client" style="endArrow=open;endFill=0;strokeWidth=2;strokeColor=#444444;fontSize=14;fontStyle=2;fontColor=#444444;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:20px'&gt;Chú thích&lt;/b&gt;&lt;br&gt;&lt;br&gt;⟶ lời gọi, chiều xuống&lt;br&gt;&lt;br&gt;Phản hồi đi ngược lại theo cùng đường, không vượt cấp.&lt;br&gt;&lt;br&gt;Hộp = một lớp (trách nhiệm ghi trong hộp). Khung nét đứt = ranh giới phạm vi." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#222222;strokeWidth=2;fontSize=16;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1280" y="120" width="430" height="300" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style='font-size:22px;color:#8B2E0F'&gt;NGOÀI PHẠM VI (chủ ý không thiết kế)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Bộ nhớ đệm (cache), hàng đợi tin nhắn, cân bằng tải, microservices — prototype một luồng, 7 bảng không cần.&lt;br&gt;&lt;br&gt;• Phân công kỹ thuật viên, lịch hẹn (L4), kho linh kiện (L5), báo cáo đa chiều (L6).&lt;br&gt;&lt;br&gt;• Triển khai hạ tầng, giám sát, mô hình hóa mối đe dọa bảo mật (thuộc CĐTN2)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF5EB;strokeColor=#B45309;strokeWidth=2;fontSize=17;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=14;spacingTop=14;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="60" y="1070" width="1680" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>